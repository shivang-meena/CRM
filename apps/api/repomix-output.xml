  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  reminder LeadReminder @relation(fields: [reminderId], references: [id], onDelete: Restrict)

  @@index([recipientId, readAt, createdAt])
  @@map("crm_notifications")
}

model TaskLabel {
  id              String                    @id @default(uuid())
  name            String
  normalizedName  String
  colour          String
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?                 @db.Timestamptz(3)
  tasks           Task[]
  recurrenceSeries TaskRecurrenceSeries[]

  @@index([normalizedName, deletedAt])
  @@map("task_labels")
}

model TaskRecurrenceSeries {
  id                String                  @id @default(uuid())
  subject           String
  description       String?
  priority          StandaloneTaskPriority  @default(LOW)
  labelId           String?
  assignedTo        String
  createdById       String
  createdByName     String
  frequency         TaskRecurrenceFrequency
  interval          Int                     @default(1)
  timezone          String                  @default("Asia/Kolkata")
  anchorStartAt     DateTime                @db.Timestamptz(3)
  durationMinutes   Int
  recurrenceEndsAt  DateTime?               @db.Timestamptz(3)
  nextOccurrenceAt  DateTime                @db.Timestamptz(3)
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  version           Int                     @default(1)
  label             TaskLabel?              @relation(fields: [labelId], references: [id], onDelete: Restrict)
  tasks             Task[]

  @@index([active, nextOccurrenceAt])
  @@index([labelId, active])
  @@map("task_recurrence_series")
}

model Task {
  id                String                  @id @default(uuid())
  subject           String
  description       String?
  priority          StandaloneTaskPriority  @default(LOW)
  status            StandaloneTaskStatus     @default(NEW)
  labelId           String?
  startAt           DateTime                @db.Timestamptz(3)
  endAt             DateTime                @db.Timestamptz(3)
  assignedTo        String
  createdById       String
  createdByName     String
  updatedById       String?
  updatedByName     String?
  completedAt       DateTime?               @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?               @db.Timestamptz(3)
  version           Int                     @default(1)
  requestKey        String?
  requestHash       String?
  recurrenceSeriesId String?
  occurrenceAt      DateTime?               @db.Timestamptz(3)
  label             TaskLabel?              @relation(fields: [labelId], references: [id], onDelete: Restrict)
  recurrenceSeries  TaskRecurrenceSeries?   @relation(fields: [recurrenceSeriesId], references: [id], onDelete: Restrict)
  history           TaskHistory[]

  @@unique([createdById, requestKey])
  @@unique([recurrenceSeriesId, occurrenceAt])
  @@index([status, deletedAt, endAt])
  @@index([assignedTo, deletedAt, endAt])
  @@index([labelId, deletedAt])
  @@index([deletedAt, endAt])
  @@index([recurrenceSeriesId, occurrenceAt])
  @@map("tasks")
}

model TaskHistory {
  id          String            @id @default(uuid())
