generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  ACTIVE
  BLOCKED
}

model Admin {
  id           String      @id @default(uuid())
  loginId      String      @unique
  passwordHash String
  name         String
  businessName String      @default("")
  phone        String?
  email        String?
  status       AdminStatus @default(ACTIVE)
  blockedAt    DateTime?   @db.Timestamptz(3)

  // Features (one per CRM module). Super Admin switches these ON/OFF.
  featLead     Boolean     @default(true)
  featReminder Boolean     @default(true)
  featMeeting  Boolean     @default(true)
  featNote     Boolean     @default(true)
  featCalendar Boolean     @default(true)
  featCustomer Boolean     @default(true)
  featInvoice  Boolean     @default(true)
  featStaff    Boolean     @default(true)
  featLeave    Boolean     @default(true)

  version      Int         @default(1)
  deletedAt    DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@map("admins")
}

enum LeadStatus {
  NEW
  PROCESSING
  CLOSE_BY
  CONFIRM
  CANCEL
}

enum LeadSource {
  CUSTOMER_REFERENCE
  WEBSITE
  CALL
  WHATSAPP
  SOCIAL_MEDIA
  OTHER
}

model Lead {
  id              String     @id @default(uuid())
  name            String
  companyName     String?
  phone           String
  email           String?
  address         String?
  state           String?
  comment         String?
  reference       String?
  serviceId       String?
  service         ServiceMaster? @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceSelections LeadServiceSelection[]
  productSelections LeadProductSelection[]
  status          String     @default("NEW")
  source          LeadSource @default(CUSTOMER_REFERENCE)
  label           String?
  estimatedAmount Decimal    @default(0) @db.Decimal(14, 2)
  rating          Int        @default(0)
  nextFollowUpAt  DateTime?
  createdBy       String
  assignedTo      String
  assignedToId    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?  @db.Timestamptz(3)
  version         Int        @default(1)
  followups       LeadFollowUp[]
  meetings        LeadMeeting[]
  reminders       LeadReminder[]
  history         LeadHistory[]
  documents       SalesDocument[]
  notifications   CrmNotification[]
  customer        Customer?

  @@index([status])
  @@index([serviceId])
  @@map("leads")
  adminId String
  @@index([adminId])
}

model ServiceMaster {
  id             String   @id @default(uuid())
  name           String
  normalizedName String
  hsnSac         String   @default("")
  description    String?  @default("")
  igstRate       Decimal  @default(0) @db.Decimal(5, 2)
  sgstRate       Decimal  @default(0) @db.Decimal(5, 2)
  cgstRate       Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leads          Lead[]
  leadSelections LeadServiceSelection[]

  @@unique([adminId, normalizedName])
  @@map("service_masters")
  adminId String
  @@index([adminId])
}

model ProductMaster {
  id             String   @id @default(uuid())
  name           String
  normalizedName String
  hsnSac         String   @default("")
  description    String?  @default("")
  igstRate       Decimal  @default(0) @db.Decimal(5, 2)
  sgstRate       Decimal  @default(0) @db.Decimal(5, 2)
  cgstRate       Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  leadSelections LeadProductSelection[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([adminId, normalizedName])
  @@map("product_masters")
  adminId String
  @@index([adminId])
}

model LeadServiceSelection {
  adminId   String
  leadId    String
  serviceId String
  position  Int @default(0)

  lead    Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service ServiceMaster @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([leadId, serviceId])
  @@index([adminId, leadId])
  @@index([serviceId])
  @@map("lead_service_selections")
}

model LeadProductSelection {
  adminId   String
  leadId    String
  productId String
  position  Int @default(0)

  lead    Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product ProductMaster @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([leadId, productId])
  @@index([adminId, leadId])
  @@index([productId])
  @@map("lead_product_selections")
}

model LeadStatusMaster {
  id             String   @id @default(uuid())
  name           String
  normalizedName String
  code           String?
  color          String   @default("#0284c7")
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([adminId, normalizedName])
  @@unique([adminId, code])
  @@map("lead_status_masters")
  adminId String
  @@index([adminId])
}

model Customer {
  id              String   @id @default(uuid())
  leadId          String   @unique
  convertedAt     DateTime @default(now()) @db.Timestamptz(3)
  convertedById   String
  convertedByName String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documents       SalesDocument[]

  @@index([convertedAt, id])
  @@map("customers")
  adminId String
  @@index([adminId])
}

enum FollowUpChannel {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ActivityOrigin {
  USER
  LEGACY
}

enum MeetingMode {
  ONLINE
  PHONE
  IN_PERSON
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReminderStatus {
  PENDING
  TRIGGERED
  DISMISSED
  CANCELLED
}

enum CalendarEventCategory {
  EVENT
  HOLIDAY
  SERVICE
}

enum HistoryEntity {
  LEAD
  FOLLOWUP
  REMINDER
  MEETING
  QUOTATION
  INVOICE
  PAYMENT
}

enum HistoryAction {
  CREATED
  UPDATED
  COMPLETED
  CANCELLED
  DELETED
  ARCHIVED
  TRIGGERED
  DISMISSED
  FINALIZED
  ACCEPTED
  REJECTED
  ISSUED
  VOIDED
  CONVERTED
  IMPORTED
}

enum DocumentType {
  QUOTATION
  INVOICE
}

enum DocumentStatus {
  DRAFT
  FINALIZED
  ACCEPTED
  REJECTED
  CANCELLED
  ISSUED
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

model LeadFollowUp {
  id String @id @default(uuid())
  leadId String
  createdById String
  createdByName String
  updatedById String?
  updatedByName String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  requestKey String?
  requestHash String?
  title String
  description String?
  scheduledAt DateTime @db.Timestamptz(3)
  channel FollowUpChannel @default(CALL)
  status FollowUpStatus @default(PENDING)
  assignedTo String
  assignedToId String?
  outcome String?
  completedAt DateTime? @db.Timestamptz(3)
  origin ActivityOrigin @default(USER)
  legacyKey String? @unique
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  reminders LeadReminder[]
  @@unique([createdById, requestKey])
  @@index([leadId, deletedAt, scheduledAt])
  @@index([leadId, status, scheduledAt])
  @@map("lead_followups")
  adminId String
  @@index([adminId])
}

model LeadMeeting {
  id String @id @default(uuid())
  leadId String?
  createdById String
  createdByName String
  updatedById String?
  updatedByName String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  requestKey String?
  requestHash String?
  title String
  agenda String?
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  timezone String @default("Asia/Kolkata")
  mode MeetingMode @default(ONLINE)
  location String?
  meetingUrl String?
  attendees Json @default("[]")
  assignedTo String
  assignedToId String?
  status MeetingStatus @default(SCHEDULED)
  outcome String?
  completedAt DateTime? @db.Timestamptz(3)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  reminders LeadReminder[]
  @@unique([createdById, requestKey])
  @@index([leadId, deletedAt, startAt])
  @@index([status, startAt])
  @@map("lead_meetings")
  adminId String
  @@index([adminId])
}

model LeadReminder {
  id String @id @default(uuid())
  leadId String?
  createdById String
  createdByName String
  updatedById String?
  updatedByName String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  requestKey String?
  requestHash String?
  title String
  message String?
  remindAt DateTime @db.Timestamptz(3)
  recipientId String
  assignedTo String?
  assignedToId String?
  status ReminderStatus @default(PENDING)
  followUpId String?
  meetingId String?
  triggeredAt DateTime? @db.Timestamptz(3)
  dismissedAt DateTime? @db.Timestamptz(3)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  followUp LeadFollowUp? @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  meeting LeadMeeting? @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  notification CrmNotification?
  @@unique([createdById, requestKey])
  @@index([status, deletedAt, remindAt])
  @@map("lead_reminders")
  adminId String
  @@index([adminId])
}

model LeadHistory {
  id String @id @default(uuid())
  leadId String
  entityType HistoryEntity
  entityId String?
  action HistoryAction
  actorId String
  actorName String
  summary String
  changes Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)


  @@index([leadId, createdAt, id])
  @@map("lead_history")
  adminId String
  @@index([adminId])
}

enum SalesDocumentType {
  QUOTATION
  INVOICE
}

enum SalesDocumentStatus {
  DRAFT
  FINALIZED
  ACCEPTED
  REJECTED
  ISSUED
  VOID
}

enum GstMode {
  NON_GST
  IGST
  SGST_CGST
}

enum DiscountType {
  FIXED
  OVERALL
  PERCENTAGE
  FLAT_PER_UNIT
}

enum SalesItemType {
  SERVICE
  PRODUCT
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  HALF_PAID
  PAID
}

model SalesDocument {
  id                      String                @id @default(uuid())
  documentNo              String
  type                    SalesDocumentType     @default(INVOICE)
  status                  SalesDocumentStatus   @default(ISSUED)
  sourceQuotationId       String?               @unique
  customerId              String
  customer                Customer              @relation(fields: [customerId], references: [id])
  leadId                  String?
  lead                    Lead?                 @relation(fields: [leadId], references: [id])
  issueDate               DateTime              @default(now())
  paymentDate             DateTime?             @db.Date
  nextPaymentDate         DateTime?
  gstMode                 GstMode               @default(NON_GST)
  inclusiveGst            Boolean               @default(false)
  currency                String                @default("INR")
  paymentStatus           InvoicePaymentStatus  @default(UNPAID)
  paymentMethodId         String?
  paymentMethod           PaymentMethodMaster?  @relation(fields: [paymentMethodId], references: [id])
  brochureId              String?
  brochure                BrochureMaster?       @relation(fields: [brochureId], references: [id])
  termsAndConditions      String?
  emailAutomation         Boolean               @default(false)
  whatsappAutomation      Boolean               @default(false)

  // Authoritative Financial Totals
  grossSubtotal           Decimal               @default(0) @db.Decimal(12, 2)
  subtotal                Decimal               @default(0) @db.Decimal(12, 2) // Taxable subtotal
  discountTotal           Decimal               @default(0) @db.Decimal(12, 2)
  igstTotal               Decimal               @default(0) @db.Decimal(12, 2)
  sgstTotal               Decimal               @default(0) @db.Decimal(12, 2)
  cgstTotal               Decimal               @default(0) @db.Decimal(12, 2)
  taxTotal                Decimal               @default(0) @db.Decimal(12, 2)
  grandTotal              Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount              Decimal               @default(0) @db.Decimal(12, 2)
  dueAmount               Decimal               @default(0) @db.Decimal(12, 2)

  // Immutable Document Snapshots (Preserved at issue time)
  customerNameSnapshot    String?
  companyNameSnapshot     String?
  customerPhoneSnapshot   String?
  customerEmailSnapshot   String?
  customerAddressSnapshot String?
  customerStateSnapshot   String?
  customerGstinSnapshot   String?
  sellerCompanyName       String                @default("")
  sellerPhone             String                @default("")
  sellerEmail             String                @default("")
  sellerAddress           String                @default("")
  companyProfileSnapshot  Json?
  gstInvoiceSettingsSnapshot Json?
  nonGstInvoiceSettingsSnapshot Json?
  bankName                String                @default("")
  bankAccountNo           String                @default("")
  bankIfsc                String                @default("")
  signatoryName           String                @default("")

  createdById             String?
  createdByName           String                @default("System User")
  requestKey              String?
  version                 Int                   @default(1)
  deletedAt               DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  items                   SalesDocumentItem[]
  payments                InvoicePayment[]

  @@unique([adminId, documentNo])
  @@unique([adminId, requestKey])
  @@index([type, deletedAt, issueDate])
  @@index([customerId])
  @@map("sales_documents")
  adminId String
  @@index([adminId])
}

model SalesDocumentItem {
  id              String        @id @default(uuid())
  salesDocumentId String
  salesDocument   SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  productName     String
  hsnSac          String?
  hsnMasterId     String? // Source reference; invoice values remain snapshots.
  itemType        SalesItemType?
  hsnDescription  String?
  quantity        Int           @default(1)
  unitPrice       Decimal       @default(0) @db.Decimal(12, 2)
  discountValue   Decimal       @default(0) @db.Decimal(12, 2)
  discountType    DiscountType  @default(FIXED)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  grossAmount     Decimal       @default(0) @db.Decimal(12, 2)
  netAmount       Decimal       @default(0) @db.Decimal(12, 2) // Taxable base amount
  igstRate        Decimal       @default(0) @db.Decimal(5, 2)
  igstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  sgstRate        Decimal       @default(0) @db.Decimal(5, 2)
  sgstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  cgstRate        Decimal       @default(0) @db.Decimal(5, 2)
  cgstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  taxPercent      Decimal       @default(0) @db.Decimal(5, 2) // Combined rate for backward compatibility
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  comments        String?
  sortOrder       Int           @default(0)

  @@index([salesDocumentId])
  @@map("sales_document_items")
}

model HsnMaster {
  id          String   @id @default(uuid())
  code        String
  description String
  igstRate    Decimal  @db.Decimal(5, 2)
  sgstRate    Decimal  @db.Decimal(5, 2)
  cgstRate    Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([adminId, code])
  @@map("hsn_master")
  adminId String
  @@index([adminId])
}

model PaymentMethodMaster {
  id            String          @id @default(uuid())
  method        String
  bankName      String?
  accountNo     String?
  ifscCode      String?
  isDefault     Boolean         @default(false)
  isActive      Boolean         @default(true)
  version       Int             @default(1)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  documents     SalesDocument[]

  @@map("payment_method_masters")
  adminId String
  @@index([adminId])
}

model BrochureMaster {
  id            String          @id @default(uuid())
  brochureName  String
  type          String          @default("PDF")
  startAfter    String          @default("Immediate")
  fileUrl       String?
  version       Int             @default(1)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  documents     SalesDocument[]

  @@map("brochure_masters")
  adminId String
  @@index([adminId])
}

model DocumentSequence {
  id String @id @default(uuid())
  documentType DocumentType
  year Int
  lastNumber Int @default(0)

  @@unique([adminId, documentType, year])

  @@map("document_sequences")
  adminId String
  @@index([adminId])
}

model InvoicePayment {
  id String @id @default(uuid())
  invoiceId String
  amount Decimal @default(0) @db.Decimal(16, 2)
  paidAt DateTime @db.Timestamptz(3)
  method PaymentMethod
  reference String?
  note String?
  createdById String
  createdByName String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  requestKey String
  requestHash String
  voidedAt DateTime? @db.Timestamptz(3)
  voidedById String?
  voidReason String?
  invoice SalesDocument @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  @@unique([createdById, requestKey])
  @@index([invoiceId, paidAt])
  @@map("invoice_payments")
  adminId String
  @@index([adminId])
}

model CrmNotification {
  id String @id @default(uuid())
  leadId String?
  reminderId String @unique
  recipientId String
  title String
  message String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  reminder LeadReminder @relation(fields: [reminderId], references: [id], onDelete: Restrict)

  @@index([recipientId, readAt, createdAt])
  @@map("crm_notifications")
  adminId String
  @@index([adminId])
}

model Note {
  id          String    @id @default(uuid())
  content     String
  createdById String
  createdByName String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  version     Int       @default(1)
  requestKey  String?
  requestHash String?

  @@unique([createdById, requestKey])
  @@index([createdById, deletedAt, createdAt, id])
  @@map("notes")
  adminId String
  @@index([adminId])
}

model CalendarEvent {
  id            String                @id @default(uuid())
  category      CalendarEventCategory @default(EVENT)
  title         String
  description   String?
  startAt       DateTime              @db.Timestamptz(3)
  endAt         DateTime              @db.Timestamptz(3)
  allDay        Boolean               @default(false)
  timezone      String                @default("Asia/Kolkata")
  createdById   String
  createdByName String
  updatedById   String?
  updatedByName String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  version       Int                   @default(1)
  requestKey    String
  requestHash   String

  @@unique([createdById, requestKey])
  @@index([createdById, deletedAt, startAt])
  @@map("calendar_events")
  adminId String
  @@index([adminId])
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model StaffMember {
  id             String      @id @default(uuid())
  firstName      String
  lastName       String
  email          String      @unique
  phone          String?
  birthDate      DateTime?   @db.Date
  joiningDate    DateTime    @db.Date
  status         StaffStatus @default(ACTIVE)
  department     String?
  designation    String?
  employeeCode   String?
  // Login credentials
  passwordHash   String?
  canLoginApp    Boolean     @default(false)
  // Module permissions
  permLead       Boolean     @default(true)
  permReminder   Boolean     @default(true)
  permMeeting    Boolean     @default(true)
  permNote       Boolean     @default(true)
  permCalendar   Boolean     @default(true)
  permCustomer   Boolean     @default(true)
  permInvoice    Boolean     @default(false)
  permStaff      Boolean     @default(false)
  permLeave      Boolean     @default(true)
  version        Int         @default(1)
  deletedAt      DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  leaves         LeaveRequest[]

  @@unique([adminId, employeeCode])
  @@index([status, deletedAt])
  @@index([lastName, firstName])
  @@index([joiningDate])
  @@map("staff_members")
  adminId String
  @@index([adminId])
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model GstInvoiceSettings {
  id                 String   @id @default(uuid())
  invoicePrefix      String   @default("GST")
  invoiceStart       Int      @default(1)
  nextNumber         Int      @default(1)
  gstPercentage      Float    @default(18)
  invoiceCurrency    String   @default("INR")
  hsnSac             String   @default("9983")
  bankName           String   @default("")
  accountNo          String   @default("")
  ifscCode           String   @default("")
  paymentUpiId       String   @default("")
  signature          String   @default("") @db.Text
  termsAndConditions String   @default("") @db.Text
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@map("gst_invoice_settings")
  adminId String   @unique
}

model NonGstInvoiceSettings {
  id                 String   @id @default(uuid())
  invoicePrefix      String   @default("NON-GST")
  invoiceStart       Int      @default(1)
  nextNumber         Int      @default(1)
  invoiceCurrency    String   @default("INR")
  hsnSac             String   @default("9983")
  bankName           String   @default("")
  accountNo          String   @default("")
  ifscCode           String   @default("")
  paymentUpiId       String   @default("")
  signature          String   @default("") @db.Text
  termsAndConditions String   @default("") @db.Text
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@map("non_gst_invoice_settings")
  adminId String   @unique
}

model CompanyProfile {
  id                            String   @id @default(uuid())
  companyName                   String   @default("")
  contactNumber                 String   @default("")
  dialCode                      String   @default("+91")
  gstNumber                     String   @default("")
  email                         String   @default("")
  address                       String   @default("")
  logo                          String   @default("") @db.Text
  country                       String   @default("India")
  state                         String   @default("")
  city                          String   @default("")
  businessCategory              String   @default("")
  openingTime                   String   @default("")
  closingTime                   String   @default("")
  considerOvertime              Boolean  @default(false)
  themeColor                    String   @default("#1966A6")
  fontColor                     String   @default("#1966A6")
  missedFollowUpReminder        Boolean  @default(false)
  staffWhatsAppDeviceReconnect  Boolean  @default(false)
  updatedAt                     DateTime @updatedAt @db.Timestamptz(3)

  @@map("company_profile")
  adminId String   @unique
}

model LeaveRequest {
  id            String       @id @default(uuid())
  staffId       String?
  staffName     String
  type          LeaveType    @default(CASUAL)
  status        LeaveStatus  @default(PENDING)
  startDate     DateTime     @db.Timestamptz(3)
  endDate       DateTime     @db.Timestamptz(3)
  reason        String
  leaveDetail   String?
  appliedAt     DateTime     @default(now()) @db.Timestamptz(3)
  reviewedAt    DateTime?    @db.Timestamptz(3)
  reviewedById  String?
  reviewedByName String?
  rejectionNote String?
  version       Int          @default(1)
  deletedAt     DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  staff         StaffMember? @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId, deletedAt, appliedAt])
  @@index([status, deletedAt, appliedAt])
  @@map("leave_requests")
  adminId String
  @@index([adminId])
}
