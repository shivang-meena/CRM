import React from 'react';
import { StyleSheet, Text, View, Pressable } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { colors } from '@/theme/colors';
import ConvertLeadAction from './ConvertLeadAction';

type Props = {
  leadId: string;
  onCustomerOpen?: () => void;
  onAddFollowUp: () => void;
  onAddTask: () => void;
  onAddReminder: () => void;
  onAddMeeting: () => void;
  onCreateQuotation: () => void;
  onCreateInvoice: () => void;
};

interface ActionItem {
  key: string;
  label: string;
  icon: keyof typeof Ionicons.glyphMap;
  onPress: () => void;
  primary?: boolean;
}

export default function LeadActionBar({
  leadId, onCustomerOpen, onAddFollowUp, onAddTask, onAddReminder,
  onAddMeeting, onCreateQuotation, onCreateInvoice,
}: Props) {
  const actions: ActionItem[] = [
    { key: 'followup', label: 'Add FollowUp', icon: 'call-outline', onPress: onAddFollowUp },
    { key: 'task', label: 'Add Task', icon: 'checkbox-outline', onPress: onAddTask },
    { key: 'reminder', label: 'Add Reminder', icon: 'alarm-outline', onPress: onAddReminder },
    { key: 'meeting', label: 'Add Meeting', icon: 'calendar-outline', onPress: onAddMeeting },
    { key: 'quotation', label: 'Create Quotation', icon: 'document-text-outline', onPress: onCreateQuotation },
    { key: 'invoice', label: 'Create Invoice', icon: 'receipt-outline', onPress: onCreateInvoice, primary: true },
  ];

  return (
    <View style={styles.container}>
      <Text style={styles.sectionHeading}>Quick Actions</Text>
      <View style={styles.actionsRow}>
        {actions.map(item => (
          <React.Fragment key={item.key}>
            {item.key === 'meeting' ? (
              <ConvertLeadAction key={leadId} leadId={leadId} onCustomerOpen={onCustomerOpen} />
            ) : null}
            <Pressable
              accessibilityRole="button"
              accessibilityLabel={item.label}
              onPress={item.onPress}
              style={({ pressed }) => [
                styles.actionBtn,
                item.primary ? styles.primaryBtn : styles.outlineBtn,
                pressed && styles.pressedBtn,
              ]}
            >
              <Ionicons name={item.icon} size={16} color={item.primary ? colors.white : colors.primaryText} />
              <Text style={[styles.actionText, item.primary ? styles.primaryText : styles.outlineText]}>
                {item.label}
              </Text>
            </Pressable>
          </React.Fragment>
        ))}
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    backgroundColor: colors.white, borderWidth: 1, borderColor: colors.border,
    borderRadius: 8, padding: 12, gap: 8,
  },
  sectionHeading: {
    fontSize: 12, fontWeight: '700', color: colors.muted,
    textTransform: 'uppercase', letterSpacing: 0.5,
  },
  actionsRow: { flexDirection: 'row', flexWrap: 'wrap', gap: 8, alignItems: 'center' },
  actionBtn: {
    flexDirection: 'row', alignItems: 'center', gap: 6,
    paddingHorizontal: 12, paddingVertical: 9, borderRadius: 6, minHeight: 38,
  },
  outlineBtn: { backgroundColor: colors.white, borderWidth: 1, borderColor: colors.border },
  primaryBtn: { backgroundColor: colors.accent },
  pressedBtn: { opacity: 0.8 },
  actionText: { fontSize: 13, fontWeight: '700' },
  outlineText: { color: colors.primaryText },
  primaryText: { color: colors.white },
});
</file>

<file path="src/components/lead/LeadDetailsModal.tsx">
import React, { useState } from 'react';
import {
  ActivityIndicator,
  Modal,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { colors } from '@/theme/colors';
import { useAuth } from '@/context/AuthContext';
import { useDeleteLead, useLead } from '@/hooks/useLeads';
import { useSectionSummary } from '@/hooks/useLeadActivities';
import { LeadSection } from '@/types/leadActivities';
import { SalesDocument } from '@/types/salesDocuments';
import Button from '@/components/Button';
import ConfirmDialog from '@/components/ConfirmDialog';
import LeadFormModal from '@/components/LeadFormModal';

import LeadHeader from './LeadHeader';
import LeadActionBar from './LeadActionBar';
import LeadSectionTabs from './LeadSectionTabs';
import LeadDetailsSection from './LeadDetailsSection';
import FollowUpsSection from './FollowUpsSection';
import TasksSection from './TasksSection';
import RemindersSection from './RemindersSection';
import MeetingsSection from './MeetingsSection';
import QuotationsSection from './QuotationsSection';
import InvoicesSection from './InvoicesSection';
import HistorySection from './HistorySection';

import FollowUpFormModal from './FollowUpFormModal';
import TaskFormModal from './TaskFormModal';
import ReminderFormModal from './ReminderFormModal';
import MeetingFormModal from './MeetingFormModal';
import SalesDocumentFormModal from './SalesDocumentFormModal';

type Props = {
  visible: boolean;
  leadId: string | null;
  onClose: () => void;
};

export default function LeadDetailsModal({ visible, leadId, onClose }: Props) {
  const { userName } = useAuth();
  const [selectedSection, setSelectedSection] = useState<LeadSection>('details');

  const {
    data: lead,
    isLoading: leadLoading,
    isError: leadError,
    refetch: refetchLead,
  } = useLead(leadId ?? '');

  const {
    data: summary,
    isLoading: summaryLoading,
    isError: summaryError,
    refetch: refetchSummary,
  } = useSectionSummary(leadId ?? '');

  const del = useDeleteLead();

  // Sub-modals
  const [editLeadOpen, setEditLeadOpen] = useState(false);
  const [deleteConfirmOpen, setDeleteConfirmOpen] = useState(false);
  const [followUpOpen, setFollowUpOpen] = useState(false);
  const [taskOpen, setTaskOpen] = useState(false);
  const [reminderOpen, setReminderOpen] = useState(false);
  const [meetingOpen, setMeetingOpen] = useState(false);
  const [quotationOpen, setQuotationOpen] = useState(false);
  const [invoiceOpen, setInvoiceOpen] = useState(false);

  if (!visible || !leadId) return null;

  async function confirmDelete() {
    if (!lead) return;
    try {
      await del.mutateAsync(lead.id);
      onClose();
    } finally {
      setDeleteConfirmOpen(false);
    }
  }

  function handleRecordSaved(targetSection: LeadSection) {
    setSelectedSection(targetSection);
    void refetchSummary();
    void refetchLead();
  }

  return (
    <Modal visible={visible} transparent animationType="fade" onRequestClose={onClose}>
      <View style={styles.overlay}>
        <View style={styles.modalBox}>
          {/* Top Title Bar with Dimmed Backdrop and Close Button */}
          <View style={styles.titleBar}>
            <View style={styles.titleLeft}>
              <Text style={styles.titleText}>Lead Details</Text>
              {lead && (
                <Text style={styles.titleSub} numberOfLines={1}>
                  · {lead.name}
                </Text>
              )}
            </View>
            <Pressable
              accessibilityRole="button"
              accessibilityLabel="Close modal"
              onPress={onClose}
              style={styles.closeBtn}
            >
              <Ionicons name="close" size={22} color={colors.white} />
            </Pressable>
          </View>

          {leadLoading ? (
            <View style={styles.loadingContainer}>
              <ActivityIndicator size="large" color="#372A8B" />
              <Text style={styles.loadingText}>Loading lead details...</Text>
            </View>
          ) : leadError || !lead ? (
            <View style={styles.errorContainer}>
              <Text style={styles.errorText}>Lead could not be loaded.</Text>
              <Button title="Close" variant="outline" onPress={onClose} />
            </View>
          ) : (
            <ScrollView
              style={styles.scrollArea}
              contentContainerStyle={styles.content}
              showsVerticalScrollIndicator={true}
            >
              {/* Header Card */}
              <LeadHeader lead={lead} />

              {/* Quick Action Buttons */}
              <LeadActionBar
                leadId={lead.id}
                onCustomerOpen={onClose}
                onAddFollowUp={() => setFollowUpOpen(true)}
                onAddTask={() => setTaskOpen(true)}
                onAddReminder={() => setReminderOpen(true)}
                onAddMeeting={() => setMeetingOpen(true)}
                onCreateQuotation={() => setQuotationOpen(true)}
                onCreateInvoice={() => setInvoiceOpen(true)}
              />

              {/* 8 Section Tabs */}
              <LeadSectionTabs
                selected={selectedSection}
                onSelect={setSelectedSection}
                summary={summary}
                loading={summaryLoading}
                error={summaryError}
              />

              {/* Selected Section View */}
              <View style={styles.sectionBody}>
                {selectedSection === 'details' && (
                  <LeadDetailsSection
                    lead={lead}
                    onEdit={() => setEditLeadOpen(true)}
                    onDelete={() => setDeleteConfirmOpen(true)}
                    onCancel={onClose}
                  />
                )}

                {selectedSection === 'followups' && (
                  <FollowUpsSection leadId={lead.id} summary={summary} />
                )}

                {selectedSection === 'history' && (
                  <HistorySection leadId={lead.id} />
                )}

                {selectedSection === 'tasks' && (
                  <TasksSection leadId={lead.id} summary={summary} />
                )}

                {selectedSection === 'reminders' && (
                  <RemindersSection leadId={lead.id} summary={summary} />
                )}

                {selectedSection === 'meetings' && (
                  <MeetingsSection leadId={lead.id} summary={summary} />
                )}

                {selectedSection === 'quotations' && (
                  <QuotationsSection
                    leadId={lead.id}
                    summary={summary}
                    onCreateInvoiceFromQuote={(_invoice: SalesDocument) => {
                      setSelectedSection('invoices');
                      void refetchSummary();
                    }}
                  />
                )}

                {selectedSection === 'invoices' && (
                  <InvoicesSection leadId={lead.id} summary={summary} />
                )}
              </View>
            </ScrollView>
          )}

          {/* Edit Lead Modal */}
          <LeadFormModal
            visible={editLeadOpen}
            lead={lead ?? null}
            defaultAssignee={userName}
            onClose={() => {
              setEditLeadOpen(false);
              void refetchLead();
            }}
          />

          {/* Delete Lead Confirm Dialog */}
          <ConfirmDialog
            visible={deleteConfirmOpen}
            title="Delete lead?"
            message={`This will archive ${lead?.name ?? 'this lead'} and retain all its linked records.`}
            loading={del.isPending}
            onConfirm={confirmDelete}
            onCancel={() => setDeleteConfirmOpen(false)}
          />

          {/* Add FollowUp Modal */}
          {followUpOpen && lead ? (
            <FollowUpFormModal
              visible={followUpOpen}
              leadId={lead.id}
              defaultAssignee={lead.assignedTo || userName}
              onSaved={() => {
                setFollowUpOpen(false);
                handleRecordSaved('followups');
              }}
              onClose={() => setFollowUpOpen(false)}
            />
          ) : null}

          {/* Add Task Modal */}
          {taskOpen && lead ? (
            <TaskFormModal
              visible={taskOpen}
              leadId={lead.id}
              defaultAssignee={lead.assignedTo || userName}
              onSaved={() => {
                setTaskOpen(false);
                handleRecordSaved('tasks');
              }}
              onClose={() => setTaskOpen(false)}
            />
          ) : null}

          {/* Add Reminder Modal */}
          {reminderOpen && lead ? (
            <ReminderFormModal
              visible={reminderOpen}
              leadId={lead.id}
              onSaved={() => {
                setReminderOpen(false);
                handleRecordSaved('reminders');
              }}
              onClose={() => setReminderOpen(false)}
            />
          ) : null}

          {/* Add Meeting Modal */}
          {meetingOpen && lead ? (
            <MeetingFormModal
              visible={meetingOpen}
              leadId={lead.id}
              defaultAssignee={lead.assignedTo || userName}
              onSaved={() => {
                setMeetingOpen(false);
                handleRecordSaved('meetings');
              }}
              onClose={() => setMeetingOpen(false)}
            />
          ) : null}

          {/* Create Quotation Modal */}
          {quotationOpen && lead ? (
            <SalesDocumentFormModal
              visible={quotationOpen}
              leadId={lead.id}
              type="QUOTATION"
              lead={lead}
              onSaved={() => {
                setQuotationOpen(false);
                handleRecordSaved('quotations');
              }}
              onClose={() => setQuotationOpen(false)}
            />
          ) : null}

          {/* Create Invoice Modal */}
          {invoiceOpen && lead ? (
            <SalesDocumentFormModal
              visible={invoiceOpen}
              leadId={lead.id}
              type="INVOICE"
              lead={lead}
              onSaved={() => {
                setInvoiceOpen(false);
                handleRecordSaved('invoices');
              }}
              onClose={() => setInvoiceOpen(false)}
            />
          ) : null}
        </View>
      </View>
    </Modal>
  );
}

const styles = StyleSheet.create({
  overlay: {
    flex: 1,
    backgroundColor: 'rgba(15, 23, 42, 0.65)',
    justifyContent: 'center',
    alignItems: 'center',
    padding: 16,
  },
  modalBox: {
    width: '100%',
    maxWidth: 1080,
    height: '92%',
    backgroundColor: colors.white,
    borderRadius: 12,
    overflow: 'hidden',
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 4 },
    shadowOpacity: 0.3,
    shadowRadius: 12,
    elevation: 8,
  },
  titleBar: {
    backgroundColor: '#281E5D',
    paddingHorizontal: 18,
    paddingVertical: 14,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
  },
  titleLeft: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 8,
    flex: 1,
  },
  titleText: {
    color: colors.white,
    fontWeight: '800',
    fontSize: 16,
  },
  titleSub: {
    color: '#E2E8F0',
    fontWeight: '600',
    fontSize: 14,
    flexShrink: 1,
  },
  closeBtn: {
    padding: 4,
    borderRadius: 6,
  },
  scrollArea: {
