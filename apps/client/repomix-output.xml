<file path="src/invoices/InvoiceFormScreen.tsx">
import React, { useMemo, useState } from 'react';
import {
  ActivityIndicator,
  Modal,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Switch,
  Text,
  TextInput,
  useWindowDimensions,
  View,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { Href, useRouter } from 'expo-router';
import { colors } from '@/theme/colors';
import DateTimePickerModal from '@/components/DateTimePickerModal';
import { useCustomers } from '@/hooks/useCustomers';
import {
  useBrochures,
  useCreateSalesDocument,
  usePaymentMethods,
  useUpdateSalesDocument,
} from '@/hooks/useSalesDocuments';
import {
  calculateInvoicePreview,
  CreateSalesDocumentPayload,
  DEFAULT_COMPANY_CONFIG,
  DiscountType,
  GstMode,
  InvoicePaymentStatus,
  SalesDocumentItem,
  SalesDocumentRecord,
  SalesDocumentType,
  STATIC_COMPANY_PROFILE,
  UpdateSalesDocumentPayload,
} from '@/types/salesDocuments';

interface InvoiceFormScreenProps {
  initialType?: SalesDocumentType;
  existingDocument?: SalesDocumentRecord;
  isClone?: boolean;
}

const DISCOUNT_OPTIONS: { label: string; value: DiscountType }[] = [
  { label: 'Overall Discount', value: 'OVERALL' },
  { label: 'Per Item Discount', value: 'FLAT_PER_UNIT' },
];

function getTodayIstFormatted(): { display: string; isoDate: string } {
  const now = new Date();
  const istTime = new Date(now.getTime() + 330 * 60 * 1000);
  const yyyy = istTime.getUTCFullYear();
  const mm = String(istTime.getUTCMonth() + 1).padStart(2, '0');
  const dd = String(istTime.getUTCDate()).padStart(2, '0');
  return {
    display: `${dd}-${mm}-${yyyy}`,
    isoDate: `${yyyy}-${mm}-${dd}`,
  };
}

function ddmmyyyyToIso(input: string): string {
  const parts = input.trim().split('-');
  if (parts.length === 3 && parts[0].length === 2 && parts[2].length === 4) {
    return `${parts[2]}-${parts[1]}-${parts[0]}`;
  }
  return input;
}

function isoToDdmmyyyy(iso?: string | null): string {
  if (!iso) return '';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const ist = new Date(d.getTime() + 330 * 60 * 1000);
  const dd = String(ist.getUTCDate()).padStart(2, '0');
  const mm = String(ist.getUTCMonth() + 1).padStart(2, '0');
  const yyyy = ist.getUTCFullYear();
  return `${dd}-${mm}-${yyyy}`;
}

export function InvoiceFormScreen({
  initialType = 'INVOICE',
  existingDocument,
  isClone = false,
}: InvoiceFormScreenProps) {
  const router = useRouter();
  const { width } = useWindowDimensions();
  const isDesktop = width >= 768;

  const today = useMemo(() => getTodayIstFormatted(), []);
  const [docType] = useState<SalesDocumentType>(
    existingDocument?.type ?? initialType,
  );
  const [dateDisplay, setDateDisplay] = useState<string>(
    existingDocument ? isoToDdmmyyyy(existingDocument.issueDate) : today.display,
  );
  const [customerId, setCustomerId] = useState<string>(
    existingDocument?.customerId ?? '',
  );
  const [customerDropdownOpen, setCustomerDropdownOpen] = useState(false);
  const [customerSearch, setCustomerSearch] = useState('');

  const [gstMode, setGstMode] = useState<GstMode>(
    existingDocument?.gstMode ??
      (existingDocument as any)?.gstType ??
      'NON_GST',
  );
  const [inclusiveGst, setInclusiveGst] = useState<boolean>(
    existingDocument?.inclusiveGst ?? false,
  );

  const [currency, setCurrency] = useState<string>(
    existingDocument?.currency ?? 'INR',
  );
  const [currencyDropdownOpen, setCurrencyDropdownOpen] = useState(false);
  const [discountDropdownIndex, setDiscountDropdownIndex] = useState<number | null>(null);

  const [items, setItems] = useState<SalesDocumentItem[]>(
    existingDocument?.items?.length
      ? existingDocument.items.map((it) => ({
          id: it.id,
          productName: it.productName,
          hsnSac: it.hsnSac || '9983',
          unitPrice: it.unitPrice,
          quantity: it.quantity,
          discountValue: it.discountValue,
          discountType:
            it.discountType === 'FIXED' ? 'OVERALL' : it.discountType || 'OVERALL',
          igstRate: it.igstRate ?? 18,
          sgstRate: it.sgstRate ?? 9,
          cgstRate: it.cgstRate ?? 9,
          comments: it.comments || '',
        }))
      : [
          {
            productName: '',
            hsnSac: '9983',
            unitPrice: 0,
            quantity: 1,
            discountValue: 0,
            discountType: 'OVERALL',
            igstRate: 18,
            sgstRate: 9,
            cgstRate: 9,
            comments: '',
          },
        ],
  );

  const [paymentStatus, setPaymentStatus] = useState<InvoicePaymentStatus>(
    existingDocument?.paymentStatus === 'HALF_PAID'
      ? 'PARTIALLY_PAID'
      : existingDocument?.paymentStatus ?? 'UNPAID',
  );
  const [paidAmountInput, setPaidAmountInput] = useState<string>(
    existingDocument?.paidAmount ? String(existingDocument.paidAmount) : '0',
  );
  const [paymentMethodId, setPaymentMethodId] = useState<string | null>(
    existingDocument?.paymentMethodId ?? null,
  );
  const [paymentMethodDropdownOpen, setPaymentMethodDropdownOpen] = useState(false);
  const [paymentDateDisplay, setPaymentDateDisplay] = useState<string>(
    existingDocument?.paymentDate
      ? isoToDdmmyyyy(existingDocument.paymentDate)
      : today.display,
  );
  const [brochureId, setBrochureId] = useState<string | null>(
    existingDocument?.brochureId ?? null,
  );
  const [brochureDropdownOpen, setBrochureDropdownOpen] = useState(false);
  const [nextPaymentDateDisplay, setNextPaymentDateDisplay] = useState<string>(
    existingDocument?.nextPaymentDate
      ? isoToDdmmyyyy(existingDocument.nextPaymentDate)
      : '',
  );
  const [nextPaymentDatePickerOpen, setNextPaymentDatePickerOpen] = useState(false);

  const [termsAndConditions, setTermsAndConditions] = useState<string>(
    existingDocument?.termsAndConditions ??
      DEFAULT_COMPANY_CONFIG.defaultTerms,
  );
  const [emailAutomation, setEmailAutomation] = useState<boolean>(
    existingDocument?.emailAutomation ?? false,
  );
  const [whatsappAutomation, setWhatsappAutomation] = useState<boolean>(
    existingDocument?.whatsappAutomation ?? false,
  );

  const [formError, setFormError] = useState<string | null>(null);
  const [previewModalOpen, setPreviewModalOpen] = useState(false);

  const { data: customerPage, isLoading: loadingCustomers } = useCustomers({
    search: '',
    page: 1,
    pageSize: 100,
  });
  const customers = useMemo(() => {
    return (Array.isArray(customerPage) ? customerPage : customerPage?.items) ?? [];
  }, [customerPage]);

  const { data: brochures = [] } = useBrochures();
  const {
    data: paymentMethods = [],
    isLoading: loadingPaymentMethods,
    isError: paymentMethodsError,
    refetch: refetchPaymentMethods,
  } = usePaymentMethods();
  const createMutation = useCreateSalesDocument();
  const updateMutation = useUpdateSalesDocument();

  const selectedCustomer = useMemo(() => {
    return (customers as any[]).find((c) => c.id === customerId);
  }, [customers, customerId]);

  const filteredCustomers = useMemo(() => {
    const q = customerSearch.trim().toLowerCase();
    if (!q) return customers as any[];
    return (customers as any[]).filter((c) => {
      const name = (c.name || c.lead?.name || '').toLowerCase();
      const company = (c.companyName || c.lead?.companyName || '').toLowerCase();
      const phone = (c.phone || c.lead?.phone || '').toLowerCase();
      return name.includes(q) || company.includes(q) || phone.includes(q);
    });
  }, [customers, customerSearch]);

  const currencySymbol = useMemo(() => {
    switch (currency) {
      case 'USD':
        return '$';
      case 'EUR':
        return '€';
      default:
        return '₹';
    }
  }, [currency]);

  // Authoritative pure client calculation matching backend
  const calculations = useMemo(() => {
    return calculateInvoicePreview({
      items,
      gstMode,
      inclusiveGst,
      docType,
      paymentStatus,
      paidAmountInput: Number(paidAmountInput) || 0,
    });
  }, [items, gstMode, inclusiveGst, docType, paymentStatus, paidAmountInput]);

  const handleUpdateItem = (idx: number, patch: Partial<SalesDocumentItem>) => {
    setItems((prev) => {
      const copy = [...prev];
      copy[idx] = { ...copy[idx], ...patch };
      return copy;
    });
  };

  const handleRemoveItem = (idx: number) => {
    setDiscountDropdownIndex(null);
    if (items.length <= 1) {
      setItems([
        {
          productName: '',
          hsnSac: '9983',
          unitPrice: 0,
          quantity: 1,
          discountValue: 0,
          discountType: 'OVERALL',
          igstRate: 18,
          sgstRate: 9,
          cgstRate: 9,
          comments: '',
        },
      ]);
    } else {
      setItems((prev) => prev.filter((_, i) => i !== idx));
    }
  };

  const handleAddItem = () => {
    setDiscountDropdownIndex(null);
    setItems((prev) => [
      ...prev,
      {
        productName: '',
        hsnSac: '9983',
        unitPrice: 0,
        quantity: 1,
        discountValue: 0,
        discountType: 'OVERALL',
        igstRate: 18,
        sgstRate: 9,
        cgstRate: 9,
        comments: '',
      },
    ]);
  };

  const handleSave = async (openPreviewAfter = false) => {
    setDiscountDropdownIndex(null);
    setPaymentMethodDropdownOpen(false);
    setFormError(null);

    if (!customerId) {
      setFormError('Please select a customer for this document.');
      return;
    }

    const validItems = items.filter((it) => it.productName.trim().length > 0);
    if (validItems.length === 0) {
      setFormError('Please add at least one line item with a product name.');
      return;
    }

    if (gstMode !== 'NON_GST') {
      const missingHsn = validItems.some((it) => !it.hsnSac?.trim());
      if (missingHsn) {
        setFormError('HSN/SAC Code is required for all items in GST mode.');
        return;
      }
    }

    const hasPayment = docType === 'INVOICE' && paymentStatus !== 'UNPAID';
    const nextPaymentDate = docType === 'INVOICE' && paymentStatus !== 'PAID' && nextPaymentDateDisplay.trim()
      ? ddmmyyyyToIso(nextPaymentDateDisplay)
      : null;
    if (nextPaymentDate !== null) {
      const parsedNextDate = new Date(nextPaymentDate);
      if (
        !/^\d{4}-\d{2}-\d{2}$/.test(nextPaymentDate) ||
        Number.isNaN(parsedNextDate.getTime()) ||
        parsedNextDate.toISOString().slice(0, 10) !== nextPaymentDate
      ) {
        setFormError('Please enter a valid next payment date in DD-MM-YYYY format.');
        return;
      }
    }
    const paymentDate = hasPayment ? ddmmyyyyToIso(paymentDateDisplay) : null;
    if (paymentDate !== null) {
      const parsedDate = new Date(paymentDate);
      if (
        !/^\d{4}-\d{2}-\d{2}$/.test(paymentDate) ||
        Number.isNaN(parsedDate.getTime()) ||
        parsedDate.toISOString().slice(0, 10) !== paymentDate
      ) {
        setFormError('Please enter a valid payment date in DD-MM-YYYY format.');
        return;
      }
    }

    const payload: CreateSalesDocumentPayload = {
      requestKey: `doc-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`,
      type: docType,
      customerId,
      issueDate: ddmmyyyyToIso(dateDisplay),
      paymentDate,
      nextPaymentDate,
      gstMode,
      gstType: gstMode,
      inclusiveGst: gstMode === 'NON_GST' ? false : inclusiveGst,
      currency,
      paymentStatus:
        docType === 'QUOTATION'
          ? ('UNPAID' as InvoicePaymentStatus)
          : paymentStatus,
      paidAmount:
        docType === 'INVOICE' && paymentStatus === 'PARTIALLY_PAID'
          ? Number(paidAmountInput) || 0
          : paymentStatus === 'PAID'
          ? calculations.grandTotal
          : 0,
      paymentMethodId,
      brochureId: brochureId || null,
      termsAndConditions,
      emailAutomation,
      whatsappAutomation,
      items: validItems.map((it) => ({
        productName: it.productName.trim(),
        hsnSac: gstMode === 'NON_GST' ? '' : it.hsnSac?.trim() || '9983',
        unitPrice: Number(it.unitPrice) || 0,
        quantity: Math.max(1, Number(it.quantity) || 1),
        discountValue: Number(it.discountValue) || 0,
        discountType: it.discountType || 'OVERALL',
        igstRate: gstMode === 'IGST' ? Number(it.igstRate) || 0 : 0,
        sgstRate: gstMode === 'SGST_CGST' ? Number(it.sgstRate) || 0 : 0,
        cgstRate: gstMode === 'SGST_CGST' ? Number(it.cgstRate) || 0 : 0,
        comments: it.comments?.trim() || '',
      })),
    };

    try {
      if (existingDocument && !isClone) {
        await updateMutation.mutateAsync({
          id: existingDocument.id,
          payload: {
            ...payload,
            version: existingDocument.version,
          } as UpdateSalesDocumentPayload,
        });
      } else {
        await createMutation.mutateAsync(payload);
      }

      if (openPreviewAfter) {
        setPreviewModalOpen(true);
      } else {
        router.push(
          (docType === 'QUOTATION' ? '/invoice/quotation' : '/invoice') as Href,
        );
      }
    } catch (err: any) {
      setFormError(err?.message || 'Failed to save document.');
    }
  };

  const isSaving = createMutation.isPending || updateMutation.isPending;

  return (
    <ScrollView
      style={styles.page}
      contentContainerStyle={styles.pageContent}
      keyboardShouldPersistTaps="handled"
    >
      {/* Main Pure White Container Card */}
      <View style={styles.mainCard}>
        {/* Section 1: Company Branding & Document Date */}
        <View style={[styles.sectionRow, isDesktop && styles.sectionRowDesktop]}>
          <View style={styles.companyBlock}>
            <View style={styles.logoBox}>
              <View style={styles.cloudBadge}>
                <Ionicons name="code-slash" size={24} color="#0B2F7D" />
              </View>
              <Text style={styles.logoTextTitle}>
                {DEFAULT_COMPANY_CONFIG.brandTitle}
              </Text>
              <Text style={styles.logoTextSub}>
                {DEFAULT_COMPANY_CONFIG.brandSubtitle}
              </Text>
            </View>

            <Text style={styles.companyNameHeading}>
              {DEFAULT_COMPANY_CONFIG.companyName}
            </Text>
            <Text style={styles.companyMetaText}>
              {DEFAULT_COMPANY_CONFIG.phone}
            </Text>
            <Text style={styles.companyMetaText}>
              {DEFAULT_COMPANY_CONFIG.email}
            </Text>
            <Text style={styles.companyMetaText}>
              {DEFAULT_COMPANY_CONFIG.address}
            </Text>
          </View>

          <View style={styles.dateBlock}>
            <Text style={styles.fieldLabel}>
              Date <Text style={styles.requiredStar}>*</Text>
            </Text>
            <TextInput
              style={styles.dateInput}
              value={dateDisplay}
              onChangeText={setDateDisplay}
              placeholder="DD-MM-YYYY"
              placeholderTextColor={colors.textMuted}
            />
          </View>
        </View>

        <View style={styles.divider} />

        {/* Section 2: Invoice To (Floating Customer Dropdown) & Static Payment Details */}
        <View
          style={[
            styles.sectionRow,
            isDesktop && styles.sectionRowDesktop,
            { zIndex: 100 },
          ]}
        >
          <View style={[styles.halfCol, { position: 'relative', zIndex: 110 }]}>
            <Text style={styles.fieldLabel}>
              {docType === 'QUOTATION' ? 'Quotation To:' : 'Invoice To:'}
            </Text>

            <View style={{ position: 'relative', zIndex: 120 }}>
              <Pressable
                style={styles.dropdownTrigger}
                onPress={() => setCustomerDropdownOpen((o) => !o)}
              >
                <Text
                  style={[
                    styles.dropdownTriggerText,
                    !selectedCustomer && styles.placeholderText,
                  ]}
                >
                  {selectedCustomer
                    ? `${
                        selectedCustomer.companyName ||
                        selectedCustomer.lead?.companyName ||
                        ''
                      } ${
                        selectedCustomer.name || selectedCustomer.lead?.name || ''
                      } (${
                        selectedCustomer.phone || selectedCustomer.lead?.phone || ''
                      })`.trim()
                    : 'Select...'}
                </Text>
                <Ionicons
                  name={customerDropdownOpen ? 'chevron-up' : 'chevron-down'}
                  size={18}
                  color={colors.textMuted}
                />
              </Pressable>

              {customerDropdownOpen && (
                <View style={styles.dropdownMenu}>
                  <TextInput
                    style={styles.dropdownSearchInput}
                    value={customerSearch}
                    onChangeText={setCustomerSearch}
                    placeholder="Search existing customer by name, company, mobile..."
                    placeholderTextColor={colors.textMuted}
                  />
                  {loadingCustomers ? (
                    <ActivityIndicator
                      size="small"
                      color={colors.primary}
                      style={{ marginVertical: 12 }}
                    />
                  ) : filteredCustomers.length === 0 ? (
                    <Text style={styles.emptyDropdownText}>
                      No existing customers found
                    </Text>
                  ) : (
                    <ScrollView style={{ maxHeight: 200 }} nestedScrollEnabled>
                      {filteredCustomers.map((cust: any) => {
                        const cName = cust.name || cust.lead?.name || 'Customer';
                        const cComp =
                          cust.companyName || cust.lead?.companyName || '';
                        const cPhone = cust.phone || cust.lead?.phone || '';
                        const isSelected = cust.id === customerId;
                        return (
                          <Pressable
                            key={cust.id}
                            style={[
                              styles.dropdownOption,
                              isSelected && styles.dropdownOptionActive,
                            ]}
                            onPress={() => {
                              setCustomerId(cust.id);
                              setCustomerDropdownOpen(false);
                            }}
                          >
                            <Text style={styles.dropdownOptionTitle}>
                              {cComp ? `${cComp} — ${cName}` : cName}
                            </Text>
                            {Boolean(cPhone) && (
                              <Text style={styles.dropdownOptionSub}>{cPhone}</Text>
                            )}
                          </Pressable>
                        );
                      })}
                    </ScrollView>
                  )}
                </View>
              )}
            </View>

            {Boolean(selectedCustomer) && (
              <View style={styles.customerSummaryPill}>
                <Ionicons
                  name="person-circle-outline"
                  size={16}
                  color={colors.primary}
                />
                <Text style={styles.customerSummaryText}>
                  {[
                    selectedCustomer.companyName ||
                      selectedCustomer.lead?.companyName,
                    selectedCustomer.name || selectedCustomer.lead?.name,
                    selectedCustomer.phone || selectedCustomer.lead?.phone,
                    selectedCustomer.address || selectedCustomer.lead?.address,
                  ]
                    .filter(Boolean)
                    .join(' • ')}
                </Text>
              </View>
            )}
          </View>

          <View style={styles.halfCol}>
            <Text style={styles.fieldLabel}>Payment Details:</Text>
            <View style={styles.bankInfoGrid}>
              <View style={styles.bankInfoRow}>
                <Text style={styles.bankInfoKey}>Bank name:</Text>
                <Text style={styles.bankInfoVal}>
                  {DEFAULT_COMPANY_CONFIG.bankName}
                </Text>
              </View>
              <View style={styles.bankInfoRow}>
                <Text style={styles.bankInfoKey}>Account No.:</Text>
                <Text style={styles.bankInfoVal}>
                  {DEFAULT_COMPANY_CONFIG.accountNo}
                </Text>
              </View>
              <View style={styles.bankInfoRow}>
                <Text style={styles.bankInfoKey}>IFSC Code:</Text>
                <Text style={styles.bankInfoVal}>
                  {DEFAULT_COMPANY_CONFIG.ifscCode}
                </Text>
              </View>
            </View>
          </View>
        </View>

        <View style={styles.divider} />

        {/* Section 3: GST Type Store & Invoice Currency */}
        <View
          style={[
            styles.sectionRow,
            isDesktop && styles.sectionRowDesktop,
            { zIndex: 70 },
          ]}
        >
          <View style={styles.halfCol}>
            <Text style={styles.fieldLabel}>
              GST Type Store <Text style={styles.requiredStar}>*</Text>
            </Text>
            <View style={styles.radioGroupRow}>
              {(
                [
                  { label: 'Non GST', value: 'NON_GST' },
                  { label: 'IGST', value: 'IGST' },
                  { label: 'SGST / CGST', value: 'SGST_CGST' },
                ] as const
              ).map((opt) => {
                const selected = gstMode === opt.value;
                return (
                  <Pressable
                    key={opt.value}
                    style={styles.radioOption}
                    onPress={() => setGstMode(opt.value)}
                  >
                    <View
                      style={[
                        styles.radioCircle,
                        selected && styles.radioCircleSelected,
                      ]}
                    >
                      {selected && <View style={styles.radioInnerDot} />}
                    </View>
                    <Text style={styles.radioLabel}>{opt.label}</Text>
                  </Pressable>
                );
              })}
            </View>

            {/* Inclusive GST Switch shown right below GST Type Store when GST active */}
            {gstMode !== 'NON_GST' && (
              <View style={styles.inclusiveToggleRow}>
                <Text style={styles.fieldLabelInline}>Inclusive GST</Text>
                <Switch
                  value={inclusiveGst}
                  onValueChange={setInclusiveGst}
                  trackColor={{ false: '#CBD5E1', true: '#0B2F7D' }}
                />
              </View>
            )}
          </View>

          <View style={[styles.halfCol, { position: 'relative', zIndex: 80 }]}>
            <Text style={styles.fieldLabel}>Invoice Currency:</Text>
            <View style={{ position: 'relative', zIndex: 90 }}>
              <Pressable
                style={styles.dropdownTrigger}
                onPress={() => setCurrencyDropdownOpen((o) => !o)}
              >
                <Text style={styles.dropdownTriggerText}>
                  {currency === 'INR'
                    ? '₹ - India'
                    : currency === 'USD'
                    ? '$ - USD'
                    : '€ - EUR'}
                </Text>
                <Ionicons name="chevron-down" size={18} color={colors.textMuted} />
              </Pressable>
              {currencyDropdownOpen && (
                <View style={styles.dropdownMenu}>
                  {[
                    { label: '₹ - India', value: 'INR' },
                    { label: '$ - USD', value: 'USD' },
                    { label: '€ - EUR', value: 'EUR' },
                  ].map((c) => (
                    <Pressable
                      key={c.value}
                      style={styles.dropdownOption}
                      onPress={() => {
                        setCurrency(c.value);
                        setCurrencyDropdownOpen(false);
                      }}
                    >
                      <Text style={styles.dropdownOptionTitle}>{c.label}</Text>
                    </Pressable>
                  ))}
                </View>
              )}
            </View>
          </View>
        </View>

        <View style={styles.divider} />

        {/* Section 4: Dynamic Line Items */}
        {items.map((item, idx) => {
          const lineCalc = calculations.lineBreakdowns[idx] || {
            grossAmount: 0,
            discountAmount: 0,
            afterDiscountAmount: 0,
            taxableAmount: 0,
            igstRate: 0,
            igstAmount: 0,
            sgstRate: 0,
            sgstAmount: 0,
            cgstRate: 0,
            cgstAmount: 0,
            taxAmount: 0,
            totalAmount: 0,
          };

          return (
            <View
              key={idx}
              style={[
                styles.itemCard,
                discountDropdownIndex === idx && styles.discountDropdownLayer,
              ]}
            >
              <View style={styles.itemRemoveTopRight}>
