import { colors } from '@/theme/colors';
import Button from './Button';
import { formatDateTime } from '@/utils/format';

type Props = {
  visible: boolean;
  value: string; // "DD-MM-YYYY HH:mm", or "DD-MM-YYYY" when dateOnly is true
  onSelect: (val: string) => void;
  onClose: () => void;
