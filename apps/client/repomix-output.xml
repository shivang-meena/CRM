import React from 'react';
import { ActivityIndicator, Modal, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import Button from '@/components/Button';
import { Task, TaskHistory, TaskStatus } from '@/types/task';
import { formatDateTime } from '@/utils/format';
import { colors } from '@/theme/colors';
import TaskStatusControl, { taskStatusLabel } from './TaskStatusControl';

export default function TaskDetailsModal({ task, history, visible, loading, stopping, onClose, onStatus, onStopRecurrence }: { task: Task | null; history: TaskHistory[]; visible: boolean; loading?: boolean; stopping?: boolean; onClose: () => void; onStatus: (status: TaskStatus) => void; onStopRecurrence: () => void }) {
  return <Modal visible={visible} transparent animationType="fade" onRequestClose={onClose}><View style={styles.overlay}><View style={styles.modal}><View style={styles.header}><Text style={styles.title}>Task Details</Text><Pressable accessibilityRole="button" accessibilityLabel="Close task details" onPress={onClose}><Ionicons name="close" size={22} color={colors.primaryText} /></Pressable></View>{loading || !task ? <View style={styles.state}><ActivityIndicator color={colors.accent} /></View> : <ScrollView contentContainerStyle={styles.body}><Text style={styles.subject}>{task.subject}</Text><Text style={styles.status}>{taskStatusLabel(task.status)} · {task.priority}</Text>{task.description ? <Text style={styles.description}>{task.description}</Text> : <Text style={styles.muted}>No description.</Text>}<Detail label="BY" value={task.createdByName} /><Detail label="TO" value={task.assignedTo} /><Detail label="START" value={formatDateTime(task.startAt)} /><Detail label="DUE" value={formatDateTime(task.endAt)} />{task.completedAt ? <Detail label="CMP" value={formatDateTime(task.completedAt)} /> : null}<Text style={styles.section}>Change Status</Text><TaskStatusControl value={task.status} onChange={onStatus} />{task.recurrenceSeries?.active ? <Button title="Stop Future Recurrence" variant="outline" onPress={onStopRecurrence} loading={stopping} /> : null}<Text style={styles.section}>History</Text>{history.length ? history.map(item => <View key={item.id} style={styles.history}><Text style={styles.historyTitle}>{item.action.split('_').join(' ')}</Text><Text style={styles.historyMeta}>{item.actorName} · {formatDateTime(item.createdAt)}</Text></View>) : <Text style={styles.muted}>No history yet.</Text>}</ScrollView>}<View style={styles.footer}><Button title="Close" variant="outline" onPress={onClose} /></View></View></View></Modal>;
}
function Detail({ label, value }: { label: string; value: string }) { return <View style={styles.detail}><Text style={styles.detailLabel}>{label}</Text><Text style={styles.detailValue}>{value}</Text></View>; }
const styles = StyleSheet.create({ overlay: { flex: 1, backgroundColor: colors.overlay, alignItems: 'center', justifyContent: 'center', padding: 14 }, modal: { width: '100%', maxWidth: 560, maxHeight: '90%', backgroundColor: colors.white, borderRadius: 10, overflow: 'hidden' }, header: { padding: 16, backgroundColor: colors.primary, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }, title: { color: colors.primaryText, fontSize: 17, fontWeight: '800' }, body: { padding: 16, gap: 10 }, subject: { color: colors.text, fontSize: 20, fontWeight: '800' }, status: { color: colors.primaryText, fontSize: 12, fontWeight: '800' }, description: { color: colors.text, fontSize: 13, lineHeight: 20, marginVertical: 5 }, muted: { color: colors.muted, fontSize: 12 }, detail: { flexDirection: 'row', gap: 8 }, detailLabel: { width: 52, color: colors.muted, fontSize: 10, fontWeight: '800' }, detailValue: { flex: 1, color: colors.text, fontSize: 12 }, section: { color: colors.text, fontSize: 13, fontWeight: '800', marginTop: 9 }, history: { borderLeftWidth: 2, borderLeftColor: colors.primarySoft, paddingLeft: 9, paddingVertical: 4 }, historyTitle: { color: colors.text, fontSize: 11, fontWeight: '800' }, historyMeta: { color: colors.muted, fontSize: 10, marginTop: 2 }, state: { minHeight: 180, alignItems: 'center', justifyContent: 'center' }, footer: { borderTopWidth: 1, borderTopColor: colors.border, padding: 14, flexDirection: 'row', justifyContent: 'flex-end' },
});
