import React, { useEffect, useState } from 'react';
import { Modal, Pressable, ScrollView, StyleSheet, Text, TextInput, View } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import Button from '@/components/Button';
import DateTimePickerModal from '@/components/DateTimePickerModal';
import { TaskFilters, TaskLabel, TaskPriority, TaskStatus } from '@/types/task';
import { formatDateTime, parseDateTimeInput } from '@/utils/format';
import { colors } from '@/theme/colors';
import TaskStatusControl from './TaskStatusControl';

export default function TaskFilterModal({ visible, filters, labels, onApply, onClose }: { visible: boolean; filters: TaskFilters; labels: TaskLabel[]; onApply: (filters: TaskFilters) => void; onClose: () => void }) {
  const [status, setStatus] = useState<TaskStatus | undefined>(filters.status); const [priority, setPriority] = useState<TaskPriority | undefined>(filters.priority); const [labelId, setLabelId] = useState(filters.labelId ?? ''); const [assignedTo, setAssignedTo] = useState(filters.assignedTo ?? ''); const [from, setFrom] = useState(filters.from ?? ''); const [to, setTo] = useState(filters.to ?? ''); const [overdue, setOverdue] = useState(filters.overdue === 'true'); const [picker, setPicker] = useState<'from' | 'to' | null>(null);
  useEffect(() => { if (visible) { setStatus(filters.status); setPriority(filters.priority); setLabelId(filters.labelId ?? ''); setAssignedTo(filters.assignedTo ?? ''); setFrom(filters.from ?? ''); setTo(filters.to ?? ''); setOverdue(filters.overdue === 'true'); } }, [visible, filters]);
  function apply() { onApply({ status, priority, labelId: labelId || undefined, assignedTo: assignedTo.trim() || undefined, from: from || undefined, to: to || undefined, overdue: overdue ? 'true' : undefined, page: 1 }); onClose(); }
  function reset() { setStatus(undefined); setPriority(undefined); setLabelId(''); setAssignedTo(''); setFrom(''); setTo(''); setOverdue(false); onApply({ page: 1 }); onClose(); }
  return <Modal visible={visible} transparent animationType="fade" onRequestClose={onClose}><View style={styles.overlay}><View style={styles.modal}><View style={styles.header}><Text style={styles.title}>Filter Tasks</Text><Pressable accessibilityRole="button" accessibilityLabel="Close filters" onPress={onClose}><Ionicons name="close" size={22} color={colors.primaryText} /></Pressable></View><ScrollView contentContainerStyle={styles.body}>
    <Text style={styles.label}>Status</Text><View style={styles.statusFilter}><Chip label="Any" selected={!status} onPress={() => setStatus(undefined)} /><TaskStatusControl value={status} onChange={value => setStatus(status === value ? undefined : value)} /></View>
    <Text style={styles.label}>Priority</Text><View style={styles.chips}>{(['LOW', 'MEDIUM', 'HIGH'] as TaskPriority[]).map(item => <Chip key={item} label={item[0] + item.slice(1).toLowerCase()} selected={priority === item} onPress={() => setPriority(priority === item ? undefined : item)} />)}</View>
    <Text style={styles.label}>Label</Text><View style={styles.chips}><Chip label="Any" selected={!labelId} onPress={() => setLabelId('')} />{labels.map(item => <Chip key={item.id} label={item.name} selected={labelId === item.id} onPress={() => setLabelId(item.id)} />)}</View>
    <Text style={styles.label}>Assignee</Text><TextInput value={assignedTo} onChangeText={setAssignedTo} placeholder="Any assignee" placeholderTextColor={colors.muted} style={styles.input} />
    <View style={styles.row}><View style={styles.half}><Text style={styles.label}>Start date from</Text><DateButton value={from} onPress={() => setPicker('from')} /></View><View style={styles.half}><Text style={styles.label}>End date to</Text><DateButton value={to} onPress={() => setPicker('to')} /></View></View>
    <Pressable accessibilityRole="checkbox" accessibilityState={{ checked: overdue }} onPress={() => setOverdue(!overdue)} style={styles.checkRow}><View style={[styles.checkbox, overdue && styles.checked]}>{overdue ? <Ionicons name="checkmark" size={14} color={colors.white} /> : null}</View><Text style={styles.checkText}>Overdue only</Text></Pressable>
  </ScrollView><View style={styles.footer}><Button title="Reset" variant="outline" onPress={reset} /><Button title="Apply" onPress={apply} /></View></View></View><DateTimePickerModal visible={!!picker} value={picker === 'from' ? formatDateTime(from) : formatDateTime(to)} title={picker === 'from' ? 'Choose Filter Start' : 'Choose Filter End'} onSelect={value => { const parsed = parseDateTimeInput(value); if (picker && parsed.value) picker === 'from' ? setFrom(parsed.value) : setTo(parsed.value); }} onClose={() => setPicker(null)} /></Modal>;
}
function DateButton({ value, onPress }: { value: string; onPress: () => void }) { return <Pressable accessibilityRole="button" onPress={onPress} style={styles.dateButton}><Text style={styles.dateText}>{value ? formatDateTime(value) : 'Any date'}</Text><Ionicons name="calendar-outline" size={16} color={colors.primaryText} /></Pressable>; }
function Chip({ label, selected, onPress }: { label: string; selected: boolean; onPress: () => void }) { return <Pressable accessibilityRole="radio" accessibilityState={{ selected }} onPress={onPress} style={[styles.chip, selected && styles.selected]}><Text style={[styles.chipText, selected && styles.selectedText]}>{label}</Text></Pressable>; }
const styles = StyleSheet.create({ overlay: { flex: 1, backgroundColor: colors.overlay, alignItems: 'center', justifyContent: 'center', padding: 14 }, modal: { width: '100%', maxWidth: 560, maxHeight: '90%', backgroundColor: colors.white, borderRadius: 10, overflow: 'hidden' }, header: { padding: 16, backgroundColor: colors.primary, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }, title: { color: colors.primaryText, fontSize: 17, fontWeight: '800' }, body: { padding: 16, gap: 10 }, label: { color: colors.text, fontSize: 12, fontWeight: '800' }, statusFilter: { gap: 6 }, chips: { flexDirection: 'row', flexWrap: 'wrap', gap: 6 }, chip: { borderWidth: 1, borderColor: colors.border, borderRadius: 7, paddingHorizontal: 10, paddingVertical: 8 }, selected: { borderColor: colors.accent, backgroundColor: colors.primarySoft }, chipText: { color: colors.muted, fontSize: 11, fontWeight: '700' }, selectedText: { color: colors.primaryText }, input: { minHeight: 42, borderWidth: 1, borderColor: colors.border, borderRadius: 7, paddingHorizontal: 11, color: colors.text }, row: { flexDirection: 'row', gap: 10, flexWrap: 'wrap' }, half: { flex: 1, minWidth: 180, gap: 5 }, dateButton: { minHeight: 42, borderWidth: 1, borderColor: colors.border, borderRadius: 7, paddingHorizontal: 10, flexDirection: 'row', alignItems: 'center', gap: 7 }, dateText: { flex: 1, color: colors.text, fontSize: 11 }, checkRow: { flexDirection: 'row', alignItems: 'center', gap: 8, paddingVertical: 6 }, checkbox: { width: 20, height: 20, borderWidth: 1, borderColor: colors.border, borderRadius: 4, alignItems: 'center', justifyContent: 'center' }, checked: { backgroundColor: colors.accent, borderColor: colors.accent }, checkText: { color: colors.text, fontSize: 12 }, footer: { borderTopWidth: 1, borderTopColor: colors.border, padding: 14, flexDirection: 'row', justifyContent: 'flex-end', gap: 9 },
});
